# Video Uploader - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains sensitive tokens

# GitHub Configuration
# Get your personal access token at: https://github.com/settings/tokens
# Required permissions: repo (full control of private repositories)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Your GitHub username (or organization name if uploading to an org repo)
GITHUB_USERNAME=your-github-username

# Name of the repository where videos will be stored
# This repository must exist on GitHub and you must have write access
GITHUB_REPOSITORY=your-video-repository-name

# Git branch where videos will be stored (default: main)
# The branch must exist in the repository
GITHUB_BRANCH=main
